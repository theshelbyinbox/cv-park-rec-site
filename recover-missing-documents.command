#!/bin/bash
# Christmas Valley Park & Rec - recover the archive's missing PDFs
# These files were removed from cvparkandrec.org, but the Internet Archive
# kept copies. This pulls those copies straight into documents/.
# Double-click this file (or run:  bash recover-missing-documents.command )
cd "$(dirname "$0")" || exit 1
echo "Recovering 64 missing PDFs from the Internet Archive ..."
ok=0; fail=0; failed=""
dl(){
  if [ -f "$2" ]; then printf "s"; return; fi
  if curl -fSL --retry 3 --connect-timeout 30 --max-time 600 --create-dirs -o "$2" "$1" 2>/dev/null; then
    ok=$((ok+1)); printf "."
  else
    rm -f "$2"; fail=$((fail+1)); failed="$failed
  FAILED: $2"
  fi
}
