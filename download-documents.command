#!/bin/bash
# Christmas Valley Park & Rec — document downloader
# Double-click this file (or run:  bash download-documents.command )
# It downloads all 228 newspaper & minutes PDFs into the documents/ folder.
cd "$(dirname "$0")" || exit 1
echo "Downloading 228 files into documents/ ..."
ok=0; fail=0; failed=""
dl(){ # $1=url  $2=dest
  if curl -fSL --retry 2 --connect-timeout 20 --create-dirs -o "$2" "$1" 2>/dev/null; then
    ok=$((ok+1)); printf "."
  else
    fail=$((fail+1)); failed="$failed
  MISSING: $2  <-  $1"
  fi
}
